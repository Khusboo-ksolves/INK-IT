<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sequence -->
        <record id="seq_ks_employee_appraisal" model="ir.sequence">
            <field name="name">Employee Appraisal Sequence</field>
            <field name="code">ks.employee.appraisal</field>
            <field name="prefix">APR/%(year)s/</field>
            <field name="padding">4</field>
        </record>

        <!-- List View -->
        <record id="view_ks_employee_appraisal_list" model="ir.ui.view">
            <field name="name">ks.employee.appraisal.list</field>
            <field name="model">ks.employee.appraisal</field>
            <field name="arch" type="xml">
                <list string="Employee Appraisals" 
                      decoration-success="state == 'completed'" 
                      decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="employee_id" widget="many2one_avatar_employee"/>
                    <field name="employee_code"/>
                    <field name="job_id"/>
                    <field name="manager_id" widget="many2one_avatar_user"/>
                    <field name="appraisal_cycle"/>
                    <field name="date"/>
                    <field name="progress" widget="progressbar" optional="show"/>
                    <field name="state" widget="badge" 
                           decoration-success="state == 'completed'" 
                           decoration-warning="state == 'in_progress'" 
                           decoration-info="state == 'sent'" 
                           decoration-muted="state in ('draft', 'cancelled')"/>
                    <field name="deadline_date" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_ks_employee_appraisal_form" model="ir.ui.view">
            <field name="name">ks.employee.appraisal.form</field>
            <field name="model">ks.employee.appraisal</field>
            <field name="arch" type="xml">
                <form string="Employee Appraisal">
                    <header>
                        <button name="action_populate_questions" 
                                string="Populate Questions" 
                                type="object" 
                                class="btn-secondary"
                                invisible="state != 'draft' or feedback_line_ids"/>
                        <button name="action_send_feedback" 
                                string="Send Request" 
                                type="object" 
                                class="btn-primary"
                                invisible="state != 'draft' or not feedback_line_ids"/>
                        <button name="action_resend_feedback" 
                                string="Resend Request" 
                                type="object" 
                                class="btn-secondary"
                                invisible="state not in ('sent', 'in_progress')"/>
                        <button name="action_start_filling" 
                                string="Start Filling" 
                                type="object" 
                                class="btn-secondary"
                                invisible="state != 'sent'"/>
                        <button name="action_mark_completed" 
                                string="Mark Completed" 
                                type="object" 
                                class="btn-primary"
                                invisible="state not in ('sent', 'in_progress')"/>
                        <button name="action_cancel" 
                                string="Cancel" 
                                type="object" 
                                class="btn-secondary"
                                invisible="state in ('completed', 'cancelled')"/>
                        <button name="action_reset_to_draft" 
                                string="Reset to Draft" 
                                type="object" 
                                class="btn-secondary"
                                invisible="state != 'cancelled'"
                                groups="base.group_system"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,sent,in_progress,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-tasks" disabled="1">
                                <div class="o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="answered_count" nolabel="1"/>/<field name="question_count" nolabel="1"/>
                                    </span>
                                    <span class="o_stat_text">Answered</span>
                                </div>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Completed" bg_color="text-bg-success" invisible="state != 'completed'"/>
                        <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="employee_id" widget="many2one_avatar_employee" options="{'no_create': True}"/>
                                <field name="employee_code" readonly="1"/>
                                <field name="job_id" readonly="1"/>
                                <field name="department_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="manager_id" widget="many2one_avatar_user" options="{'no_create': True}"/>
                                <field name="appraisal_cycle"/>
                                <field name="date"/>
                                <field name="deadline_date"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="sent_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="completed_date" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Feedback" name="feedback">
                                <field name="feedback_line_ids" 
                                       widget="section_and_note_one2many"
                                       nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="display_type" column_invisible="1"/>
                                        <field name="question_id" 
                                               readonly="display_type"
                                               invisible="display_type"
                                               required="not display_type"
                                               options="{'no_create': True}"/>
                                        <field name="name" 
                                               widget="section_and_note_text"
                                               readonly="not display_type"/>
                                        <field name="question_type" column_invisible="1"/>
                                        <field name="is_required" 
                                               widget="boolean_toggle" 
                                               invisible="display_type"
                                               readonly="1"/>
                                        <field name="answer_text" 
                                               string="Answer"
                                               invisible="display_type or question_type not in ('text', 'textarea')"
                                               required="is_required and question_type in ('text', 'textarea')"/>
                                        <field name="answer_number" 
                                               string="Answer"
                                               invisible="display_type or question_type != 'number'"
                                               required="is_required and question_type == 'number'"/>
                                        <field name="answer_date" 
                                               string="Answer"
                                               invisible="display_type or question_type != 'date'"
                                               required="is_required and question_type == 'date'"/>
                                        <field name="answer_selection" 
                                               string="Answer"
                                               invisible="display_type or question_type not in ('selection', 'multiple_choice')"
                                               required="is_required and question_type in ('selection', 'multiple_choice')"/>
                                        <field name="answer_rating" 
                                               string="Rating"
                                               widget="priority"
                                               invisible="display_type or question_type != 'rating'"
                                               required="is_required and question_type == 'rating'"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes" placeholder="Additional notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_ks_employee_appraisal_search" model="ir.ui.view">
            <field name="name">ks.employee.appraisal.search</field>
            <field name="model">ks.employee.appraisal</field>
            <field name="arch" type="xml">
                <search string="Search Employee Appraisals">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="employee_code"/>
                    <field name="manager_id"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Sent" name="sent" domain="[('state', '=', 'sent')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <separator/>
                    <filter string="April Cycle" name="april" domain="[('appraisal_cycle', '=', 'april')]"/>
                    <filter string="October Cycle" name="october" domain="[('appraisal_cycle', '=', 'october')]"/>
                    <separator/>
                    <filter string="Overdue" name="overdue" domain="[('deadline_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'in', ['sent', 'in_progress'])]"/>
                    <group>
                        <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Manager" name="group_by_manager" context="{'group_by': 'manager_id'}"/>
                        <filter string="Appraisal Cycle" name="group_by_cycle" context="{'group_by': 'appraisal_cycle'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_ks_employee_appraisal" model="ir.actions.act_window">
            <field name="name">Employee Appraisals</field>
            <field name="res_model">ks.employee.appraisal</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_ks_employee_appraisal_search"/>
            <field name="context">{'search_default_group_by_employee': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Employee Appraisal!
                </p>
                <p>
                    Manage employee appraisals and collect feedback from managers.
                </p>
            </field>
        </record>

    </data>
</odoo>
