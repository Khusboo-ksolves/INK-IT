<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job to Check Overdue Appraisals -->
        <record id="ir_cron_check_overdue_appraisals" model="ir.cron">
            <field name="name">Check Overdue Employee Appraisals</field>
            <field name="model_id" ref="model_ks_employee_appraisal"/>
            <field name="state">code</field>
            <field name="code">model._check_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
