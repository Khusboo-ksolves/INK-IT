<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Employee Appraisal: Department Head can see all records -->
        <record id="ks_employee_appraisal_rule_department_head" model="ir.rule">
            <field name="name">Employee Appraisal: Department Head - All Records</field>
            <field name="model_id" ref="model_ks_employee_appraisal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('ks_crm_team_hierarchy.group_department_head'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- Employee Appraisal: Managers can see appraisals for their employees -->
        <record id="ks_employee_appraisal_rule_manager" model="ir.rule">
            <field name="name">Employee Appraisal: Manager - Own Employees</field>
            <field name="model_id" ref="model_ks_employee_appraisal"/>
            <field name="domain_force">['|', ('manager_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Feedback Line: Department Head can see all records -->
        <record id="ks_appraisal_feedback_line_rule_department_head" model="ir.rule">
            <field name="name">Appraisal Feedback Line: Department Head - All Records</field>
            <field name="model_id" ref="model_ks_appraisal_feedback_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('ks_crm_team_hierarchy.group_department_head'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- Feedback Line: Access Based on Appraisal -->
        <record id="ks_appraisal_feedback_line_rule" model="ir.rule">
            <field name="name">Appraisal Feedback Line: Access Based on Appraisal</field>
            <field name="model_id" ref="model_ks_appraisal_feedback_line"/>
            <field name="domain_force">['|', ('appraisal_id.manager_id', '=', user.id), ('appraisal_id.employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
